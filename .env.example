# --- Supabase ---
# Project URL and ANON (public) key from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVICE ROLE key — server-side ONLY, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_SITE_URL=https://www.techtreasure.sbs

# --- Razorpay (server-side secret values) ---
# Public key used by the browser checkout. Safe to expose, but still keep the
# server-only key/secret variables below configured for API calls.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_public_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_PRO=plan_your_pro_id
RAZORPAY_PLAN_PRO_PLUS=plan_your_pro_plus_id
RAZORPAY_PLAN_PRO_MAX=plan_your_pro_max_id

# --- Google Gemini (3 keys, rotated by the generate-meta edge function) ---
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3

# --- Unsplash (server-side only; used by /api/unsplash background search) ---
# Get a Demo/Production access key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# --- Pexels (server-side only; used by /api/pexels background search) ---
# Get a free key at https://www.pexels.com/api/ — set as PEXELS_API_KEY in Vercel.
PEXELS_API_KEY=

# --- Ad networks (injected into redirector.html) ---
NEXT_PUBLIC_MONETAG_AD_CODE=
NEXT_PUBLIC_ADSTERRA_AD_CODE=
